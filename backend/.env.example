# ============================================================
# NAMMA VOTE — Backend Environment Variables
# ============================================================

# --- DATABASE (Supabase free PostgreSQL) ---
# Get from: supabase.com → Your Project → Settings → Database → URI
# IMPORTANT: Change "postgresql://" to "postgresql+asyncpg://"
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/postgres

# --- REDIS (optional for caching — leave default for local dev) ---
REDIS_URL=redis://localhost:6379

# --- GEMINI AI ---
# Get from: aistudio.google.com → Get API Key
GEMINI_API_KEY=

# --- GOOGLE MAPS ---
# Get from: console.cloud.google.com → Maps JavaScript API
GOOGLE_MAPS_API_KEY=

# --- FIREBASE (for push notifications FCM) ---
# Get from: console.firebase.google.com → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON as a single line (use JSON.stringify)
FIREBASE_SERVICE_ACCOUNT_JSON={}

# --- JWT / ADMIN ---
JWT_SECRET=changeme-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
# Generate hash: python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('your_password'))"
ADMIN_PASSWORD_HASH=

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- APP ---
DEBUG=false